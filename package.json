{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint \"frontend/src/**/*.{js,vue}\"",
        "dev:frontend": "npm --prefix frontend run dev",
        "dev:all": "concurrently -n laravel,vite,vue -c blue,magenta,green \"php artisan serve\" \"npm run dev\" \"npm run dev:frontend\"",
        "dev:api": "concurrently -n laravel,vue -c blue,green \"php artisan serve\" \"npm run dev:frontend\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^3.1",
        "lefthook": "^2.1.14",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
